# Copy to .env.auth0 and fill in. All three values come from the Auth0 dashboard:
#
# 1) Create an Application, type Native
#    -> Domain and Client ID are in Settings
#    -> Advanced Settings > Grant Types: enable "Device Code"
# 2) Create an API (APIs > Create API); its Identifier is the audience
#    -> Under Permissions add two scopes: read:status, create:project
# 3) Under the API's "Application Access" tab, authorize your Native app for
#    User-delegated Access (at least read:status) -- device flow is user-delegated
#
# Then: cp auth0.env.example .env.auth0 && fill it in && npm run auth0

AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH0_AUDIENCE=https://your-api-identifier
