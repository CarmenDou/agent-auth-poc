# 复制成 .env.auth0 再填。三个值都在 Auth0 后台拿：
#
# 1) 建一个 Application，类型选 Native
#    → Settings 里能看到 Domain 和 Client ID
#    → Advanced Settings ▸ Grant Types 勾上 "Device Code"
# 2) 建一个 API（APIs ▸ Create API），Identifier 就是 audience
#    → Permissions 里加两个 scope：read:status、create:project
#
# 然后：cp auth0.env.example .env.auth0 && 填好 && npm run auth0

AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH0_AUDIENCE=https://your-api-identifier
